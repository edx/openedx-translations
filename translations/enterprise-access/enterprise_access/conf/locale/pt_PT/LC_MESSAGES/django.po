#: enterprise_access/apps/subsidy_access_policy/admin/forms.py:40
msgid ""
"Unless disabled now, late redemptions will be disabled at midnight UTC of "
"the selected day."
msgstr ""
"A menos que seja desativado agora, os resgates tardios serão desativados à "
"meia-noite UTC do dia selecionado."

#: enterprise_access/apps/subsidy_access_policy/admin/forms.py:50
msgid "Top-up quantity in USD"
msgstr "Montante da recarga em USD"

#: enterprise_access/apps/subsidy_access_policy/admin/forms.py:52
msgid ""
"Amount of funds to add to the associated Subsidy, and also by which to "
"increase this Policy's spend_limit."
msgstr ""
"Montante de fundos a adicionar ao Subsídio associado, e também pelo qual "
"aumentar o limite de gastos desta Política."

#: enterprise_access/apps/subsidy_access_policy/admin/forms.py:60
msgid ""
"Reference the original sales object that originated this deposit. This must "
"be the 18-character case-insensitive version of the ID."
msgstr ""
"Referencie o objeto de vendas original que originou este depósito. Este deve"
" ser a versão insensível a maiúsculas e minúsculas do ID com 18 caracteres."

#: enterprise_access/apps/subsidy_access_policy/admin/forms.py:77
msgid "Learner First Name (EE-only)"
msgstr "Primeiro nome do aluno (EE-only)"

#: enterprise_access/apps/subsidy_access_policy/admin/forms.py:79
msgid ""
"First name of learner, only used for Exec Ed Redemptions. This value (along "
"with last name and D.O.B.) are not persisted; if you select 'Wait to "
"redeem', the values will be gone when you try to save later."
msgstr ""
"Primeiro nome do aluno, usado apenas para os resgates Exec Ed. Este valor "
"(junto com o último nome e a data de nascimento) não é guardado; se "
"selecionar 'Wait to redeem', os valores desaparecerão quando tentar guardar "
"posteriormente."

#: enterprise_access/apps/subsidy_access_policy/admin/forms.py:86
msgid "Learner Last Name (EE-only)"
msgstr "Último nome do aluno (EE-only)"

#: enterprise_access/apps/subsidy_access_policy/admin/forms.py:87
msgid "Last name of learner, only used for Exec Ed Redemptions"
msgstr "Último nome do aluno, usado apenas para os resgates Exec Ed"

#: enterprise_access/apps/subsidy_access_policy/admin/forms.py:91
msgid "Learner Date of Birth (EE-only)"
msgstr "Data de nascimento do aluno (EE-only)"

#: enterprise_access/apps/subsidy_access_policy/admin/forms.py:92
msgid "Learner date of birth, only used for Exec Ed Redemptions"
msgstr "Data de nascimento do aluno, usada apenas para os resgates Exec Ed"

#: enterprise_access/apps/subsidy_access_policy/admin/forms.py:96
msgid "Order UUID of existing GEAG allocation (EE-only)"
msgstr "UUID do pedido da alocação GEAG existente (EE-only)"

#: enterprise_access/apps/subsidy_access_policy/admin/forms.py:98
msgid ""
"Link new transaction to a specific Order UUID. This is rarely needed, as a "
"GEAG allocation will typically not yet exist and neither will an Order UUID."
" Only used for Exec Ed Redemptions."
msgstr ""
"Ligar a nova transação a um UUID de pedido específico. Isto raramente é "
"necessário, pois normalmente a alocação GEAG e o UUID de pedido ainda não "
"existem. Usado apenas para os resgates Exec Ed."

