#: default_data.py:5
msgid ""
"An isosceles triangle with three layers of similar height. It is shown "
"upright, so the widest layer is located at the bottom, and the narrowest "
"layer is located at the top."
msgstr ""
"Рівнобічний трикутник з трьома шарами, що мають приблизно однакову висоту. "
"Він зображений у вертикальному положенні, тому найбільш широкий шар "
"розташований внизу, а найвужчий — вгорі."

#: default_data.py:14
msgid "The Top Zone"
msgstr "Верхня зона"

#: default_data.py:15
msgid "The Middle Zone"
msgstr "Середня зона"

#: default_data.py:16
msgid "The Bottom Zone"
msgstr "Нижня зона"

#: default_data.py:18
msgid "Use this zone to associate an item with the top layer of the triangle."
msgstr ""
"Використовуйте цю зону для прив’язки елемента до верхнього шару трикутника."

#: default_data.py:19
msgid ""
"Use this zone to associate an item with the middle layer of the triangle."
msgstr ""
"Використовуйте цю зону для прив’язки елемента до середнього шару трикутника."

#: default_data.py:20
msgid ""
"Use this zone to associate an item with the bottom layer of the triangle."
msgstr ""
"Використовуйте цю зону для прив’язки елемента до нижнього шару трикутника."

#: default_data.py:22
msgid "Correct! This one belongs to The Top Zone."
msgstr "Правильно! Цей елемент належить до верхньої зони."

#: default_data.py:23
msgid "Correct! This one belongs to The Middle Zone."
msgstr "Правильно! Цей елемент належить до середньої зони."

#: default_data.py:24
msgid "Correct! This one belongs to The Bottom Zone."
msgstr "Правильно! Цей елемент належить до нижньої зони."

#: default_data.py:25
msgid "No, this item does not belong here. Try again."
msgstr "Ні, цей елемент тут не повинен бути. Спробуйте ще раз."

#: default_data.py:26
msgid "You silly, there are no zones for this one."
msgstr "Та ти дурник, для цього елемента немає зони."

#: default_data.py:27
msgid "Of course it goes here! It goes anywhere!"
msgstr "Звичайно, він тут! Він може бути розміщений будь-де!"

#: default_data.py:29
msgid "Goes to the top"
msgstr "Переходить до верхньої зони"

#: default_data.py:30
msgid "Goes to the middle"
msgstr "Переходить до середньої зони"

#: default_data.py:31
msgid "Goes to the bottom"
msgstr "Переходить до нижньої зони"

#: default_data.py:32
msgid "Goes anywhere"
msgstr "Може бути розміщений будь-де"

#: default_data.py:33
msgid "I don't belong anywhere"
msgstr "Я не належу ніде"

#: default_data.py:35
msgid "Drag the items onto the image above."
msgstr "Перетягніть елементи на зображення вище."

#: default_data.py:36
msgid "Good work! You have completed this drag and drop problem."
msgstr "Молодець! Ви завершили задачу перетягування та скидання."

#: drag_and_drop_v2.py:82
msgid "Title"
msgstr "Заголовок"

#: drag_and_drop_v2.py:83
msgid ""
"The title of the drag and drop problem. The title is displayed to learners."
msgstr ""
"Заголовок задачі перетягування та скидання. Заголовок показується учням."

#: drag_and_drop_v2.py:85
msgid "Drag and Drop"
msgstr "Перетягування та скидання"

#: drag_and_drop_v2.py:90
msgid "Mode"
msgstr "Режим"

#: drag_and_drop_v2.py:92
msgid ""
"Standard mode: the problem provides immediate feedback each time a learner "
"drops an item on a target zone. Assessment mode: the problem provides "
"feedback only after a learner drops all available items on target zones."
msgstr ""
"Стандартний режим: задача надає негайний зворотний зв'язок щоразу, коли "
"учень скидає елемент у цільову зону. Режим оцінювання: задача надає "
"зворотний зв'язок лише після того, як учень розмістить усі доступні елементи"
" в цільових зонах."

#: drag_and_drop_v2.py:99
msgid "Standard"
msgstr "Стандартний"

#: drag_and_drop_v2.py:100
msgid "Assessment"
msgstr "Оцінювання"

#: drag_and_drop_v2.py:107
msgid "Maximum attempts"
msgstr "Максимальна кількість спроб"

#: drag_and_drop_v2.py:109
msgid ""
"Defines the number of times a student can try to answer this problem. If the"
" value is not set, infinite attempts are allowed."
msgstr ""
"Визначає кількість спроб, які може зробити учень для відповіді на задачу. "
"Якщо значення не задане, дозволяється необмежена кількість спроб."

#: drag_and_drop_v2.py:118
msgid "Show title"
msgstr "Показати заголовок"

#: drag_and_drop_v2.py:119
msgid "Display the title to the learner?"
msgstr "Показувати заголовок учню?"

#: drag_and_drop_v2.py:126
msgid "Problem text"
msgstr "Текст задачі"

#: drag_and_drop_v2.py:127
msgid "The description of the problem or instructions shown to the learner."
msgstr "Опис задачі або інструкції, що показуються учню."

#: drag_and_drop_v2.py:134
msgid "Show \"Problem\" heading"
msgstr "Показати заголовок \"Задача\""

#: drag_and_drop_v2.py:135
msgid "Display the heading \"Problem\" above the problem text?"
msgstr "Показувати заголовок \"Задача\" над текстом задачі?"

#: drag_and_drop_v2.py:141
msgid "Show answer"
msgstr "Показати відповідь"

#: drag_and_drop_v2.py:142
msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings. To revert setting a custom value, choose the 'Default'"
" option."
msgstr ""
"Визначає, коли показувати відповідь на задачу. Значення за замовчуванням "
"можна встановити в Розширених налаштуваннях. Щоб скасувати налаштування "
"власного значення, оберіть опцію 'За замовчуванням'."

#: drag_and_drop_v2.py:148
msgid "Default"
msgstr "За замовчуванням"

#: drag_and_drop_v2.py:149
msgid "Always"
msgstr "Завжди"

#: drag_and_drop_v2.py:150
msgid "Answered"
msgstr "Відповілено"

#: drag_and_drop_v2.py:151
msgid "Attempted or Past Due"
msgstr "Спробовано або термін минув"

#: drag_and_drop_v2.py:152
msgid "Closed"
msgstr "Закрито"

#: drag_and_drop_v2.py:153
msgid "Finished"
msgstr "Завершено"

#: drag_and_drop_v2.py:154
msgid "Correct or Past Due"
msgstr "Правильно або термін минув"

#: drag_and_drop_v2.py:155
msgid "Past Due"
msgstr "Термін минув"

#: drag_and_drop_v2.py:156
msgid "Never"
msgstr "Ніколи"

#: drag_and_drop_v2.py:157
msgid "After All Attempts"
msgstr "Після всіх спроб"

#: drag_and_drop_v2.py:158
msgid "After All Attempts or Correct"
msgstr "Після всіх спроб або при правильній відповіді"

#: drag_and_drop_v2.py:159
msgid "Attempted"
msgstr "Спробовано"

#: drag_and_drop_v2.py:165
msgid "Problem Weight"
msgstr "Вага задачі"

#: drag_and_drop_v2.py:166
msgid "Defines the number of points the problem is worth."
msgstr "Визначає кількість балів, яку коштує задача."

#: drag_and_drop_v2.py:173
msgid "Item background color"
msgstr "Колір фону елемента"

#: drag_and_drop_v2.py:174
msgid ""
"The background color of draggable items in the problem (example: 'blue' or "
"'#0000ff')."
msgstr ""
"Колір фону перетягуваних елементів у задачі (наприклад: 'blue' або "
"'#0000ff')."

#: drag_and_drop_v2.py:181
msgid "Item text color"
msgstr "Колір тексту елемента"

#: drag_and_drop_v2.py:182
msgid "Text color to use for draggable items (example: 'white' or '#ffffff')."
msgstr ""
"Колір тексту, який використовується для перетягуваних елементів (наприклад: "
"'white' або '#ffffff')."

#: drag_and_drop_v2.py:189
msgid "Maximum items per zone"
msgstr "Максимальна кількість елементів на зону"

#: drag_and_drop_v2.py:190
msgid ""
"This setting limits the number of items that can be dropped into a single "
"zone."
msgstr ""
"Це налаштування обмежує кількість елементів, які можна розмістити в одній "
"зоні."

#: drag_and_drop_v2.py:197
msgid "Problem data"
msgstr "Дані задачі"

#: drag_and_drop_v2.py:199
msgid ""
"Information about zones, items, feedback, explanation and background image "
"for this problem. This information is derived from the input that a course "
"author provides via the interactive editor when configuring the problem."
msgstr ""
"Інформація про зони, елементи, зворотний зв'язок, пояснення та фонове "
"зображення для цієї задачі. Ця інформація береться з даних, які автор курсу "
"вводить через інтерактивний редактор при налаштуванні задачі."

#: drag_and_drop_v2.py:209
msgid ""
"Information about current positions of items that a learner has dropped on "
"the target image."
msgstr ""
"Інформація про поточні позиції елементів, які учень розмістив на цільовому "
"зображенні."

#: drag_and_drop_v2.py:216
msgid "Number of attempts learner used"
msgstr "Кількість спроб, здійснених учнем"

#: drag_and_drop_v2.py:223
msgid "Indicates whether a learner has completed the problem at least once"
msgstr "Вказує, чи учень пройшов задачу хоча б один раз"

#: drag_and_drop_v2.py:230
msgid ""
"DEPRECATED. Keeps maximum score achieved by student as a weighted value."
msgstr ""
"Застаріло. Зберігає максимальний бал, досягнутий учнем, у вигляді зваженого "
"значення."

#: drag_and_drop_v2.py:236
msgid ""
"Keeps maximum score achieved by student as a raw value between 0 and 1."
msgstr ""
"Зберігає максимальний бал, досягнутий учнем, у вигляді сирого значення від 0"
" до 1."

#: drag_and_drop_v2.py:243
msgid "Maximum score available of the problem as a raw value between 0 and 1."
msgstr "Максимальний доступний бал задачі як сире значення від 0 до 1."

#: drag_and_drop_v2.py:566
#, python-brace-format
msgid "Unknown DnDv2 mode {mode} - course is misconfigured"
msgstr "Невідомий режим DnDv2 {mode} - курс некоректно налаштований."

#: drag_and_drop_v2.py:641
msgid "show_answer handler should only be called for assessment mode"
msgstr "Обробник show_answer повинен викликатись лише в режимі оцінювання."

#: drag_and_drop_v2.py:646
msgid "The answer is unavailable"
msgstr "Відповідь недоступна."

#: drag_and_drop_v2.py:832
msgid "do_attempt handler should only be called for assessment mode"
msgstr "Обробник do_attempt повинен викликатись лише в режимі оцінювання."

#: drag_and_drop_v2.py:837 drag_and_drop_v2.py:955
msgid "Max number of attempts reached"
msgstr "Досягнуто максимальну кількість спроб."

#: drag_and_drop_v2.py:842
msgid "Submission deadline has passed."
msgstr "Термін здачі минув."

