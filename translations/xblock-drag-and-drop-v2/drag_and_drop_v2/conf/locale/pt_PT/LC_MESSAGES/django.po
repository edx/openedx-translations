#: default_data.py:5
msgid ""
"An isosceles triangle with three layers of similar height. It is shown "
"upright, so the widest layer is located at the bottom, and the narrowest "
"layer is located at the top."
msgstr ""
"Um triângulo isósceles com três camadas de altura semelhante. Mostra-se na "
"posição vertical, de forma que a camada mais larga se encontra na base e a "
"mais estreita no topo."

#: default_data.py:14
msgid "The Top Zone"
msgstr "Zona Superior"

#: default_data.py:15
msgid "The Middle Zone"
msgstr "Zona do Meio"

#: default_data.py:16
msgid "The Bottom Zone"
msgstr "Zona Inferior"

#: default_data.py:18
msgid "Use this zone to associate an item with the top layer of the triangle."
msgstr ""
"Utilize esta zona para associar um item à camada superior do triângulo."

#: default_data.py:19
msgid ""
"Use this zone to associate an item with the middle layer of the triangle."
msgstr ""
"Utilize esta zona para associar um item à camada do meio do triângulo."

#: default_data.py:20
msgid ""
"Use this zone to associate an item with the bottom layer of the triangle."
msgstr ""
"Utilize esta zona para associar um item à camada inferior do triângulo."

#: default_data.py:22
msgid "Correct! This one belongs to The Top Zone."
msgstr "Correto! Este pertence à Zona Superior."

#: default_data.py:23
msgid "Correct! This one belongs to The Middle Zone."
msgstr "Correto! Este pertence à Zona do Meio."

#: default_data.py:24
msgid "Correct! This one belongs to The Bottom Zone."
msgstr "Correto! Este pertence à Zona Inferior."

#: default_data.py:25
msgid "No, this item does not belong here. Try again."
msgstr "Não, este item não pertence aqui. Tente novamente."

#: default_data.py:26
msgid "You silly, there are no zones for this one."
msgstr "És bobo, não há zonas para este item."

#: default_data.py:27
msgid "Of course it goes here! It goes anywhere!"
msgstr "Claro, vai aqui! Vai para qualquer lugar!"

#: default_data.py:29
msgid "Goes to the top"
msgstr "Vai para o topo"

#: default_data.py:30
msgid "Goes to the middle"
msgstr "Vai para o meio"

#: default_data.py:31
msgid "Goes to the bottom"
msgstr "Vai para a parte inferior"

#: default_data.py:32
msgid "Goes anywhere"
msgstr "Vai para qualquer lugar"

#: default_data.py:33
msgid "I don't belong anywhere"
msgstr "Eu não pertenço a lugar nenhum"

#: default_data.py:35
msgid "Drag the items onto the image above."
msgstr "Arraste os itens para a imagem acima."

#: default_data.py:36
msgid "Good work! You have completed this drag and drop problem."
msgstr "Bom trabalho! Concluiu este problema de arrastar e largar."

#: drag_and_drop_v2.py:82
msgid "Title"
msgstr "Título"

#: drag_and_drop_v2.py:83
msgid ""
"The title of the drag and drop problem. The title is displayed to learners."
msgstr ""
"O título do problema de arrastar e largar. O título é apresentado aos "
"alunos."

#: drag_and_drop_v2.py:85
msgid "Drag and Drop"
msgstr "Arrastar e Largar"

#: drag_and_drop_v2.py:90
msgid "Mode"
msgstr "Modo"

#: drag_and_drop_v2.py:92
msgid ""
"Standard mode: the problem provides immediate feedback each time a learner "
"drops an item on a target zone. Assessment mode: the problem provides "
"feedback only after a learner drops all available items on target zones."
msgstr ""
"Modo padrão: o problema fornece feedback imediato cada vez que um aluno "
"larga um item numa zona-alvo. Modo de avaliação: o problema fornece feedback"
" apenas depois de o aluno ter largado todos os itens disponíveis nas zonas-"
"alvo."

#: drag_and_drop_v2.py:99
msgid "Standard"
msgstr "Padrão"

#: drag_and_drop_v2.py:100
msgid "Assessment"
msgstr "Avaliação"

#: drag_and_drop_v2.py:107
msgid "Maximum attempts"
msgstr "Tentativas máximas"

#: drag_and_drop_v2.py:109
msgid ""
"Defines the number of times a student can try to answer this problem. If the"
" value is not set, infinite attempts are allowed."
msgstr ""
"Define o número de vezes que um aluno pode tentar resolver este problema. Se"
" o valor não for definido, são permitidas tentativas ilimitadas."

#: drag_and_drop_v2.py:118
msgid "Show title"
msgstr "Mostrar título"

#: drag_and_drop_v2.py:119
msgid "Display the title to the learner?"
msgstr "Exibir o título para o aluno?"

#: drag_and_drop_v2.py:126
msgid "Problem text"
msgstr "Texto do problema"

#: drag_and_drop_v2.py:127
msgid "The description of the problem or instructions shown to the learner."
msgstr "A descrição do problema ou as instruções apresentadas ao aluno."

#: drag_and_drop_v2.py:134
msgid "Show \"Problem\" heading"
msgstr "Mostrar o cabeçalho \"Problema\""

#: drag_and_drop_v2.py:135
msgid "Display the heading \"Problem\" above the problem text?"
msgstr "Exibir o cabeçalho \"Problema\" acima do texto do problema?"

#: drag_and_drop_v2.py:141
msgid "Show answer"
msgstr "Mostrar resposta"

#: drag_and_drop_v2.py:142
msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings. To revert setting a custom value, choose the 'Default'"
" option."
msgstr ""
"Define quando mostrar a resposta ao problema. Um valor pré-definido pode ser"
" configurado em Definições Avançadas. Para reverter a definição de um valor "
"personalizado, escolha a opção 'Pré-definido'."

#: drag_and_drop_v2.py:148
msgid "Default"
msgstr "Pré-definido"

#: drag_and_drop_v2.py:149
msgid "Always"
msgstr "Sempre"

#: drag_and_drop_v2.py:150
msgid "Answered"
msgstr "Respondido"

#: drag_and_drop_v2.py:151
msgid "Attempted or Past Due"
msgstr "Tentado ou em atraso"

#: drag_and_drop_v2.py:152
msgid "Closed"
msgstr "Fechado"

#: drag_and_drop_v2.py:153
msgid "Finished"
msgstr "Concluído"

#: drag_and_drop_v2.py:154
msgid "Correct or Past Due"
msgstr "Correto ou em atraso"

#: drag_and_drop_v2.py:155
msgid "Past Due"
msgstr "Em atraso"

#: drag_and_drop_v2.py:156
msgid "Never"
msgstr "Nunca"

#: drag_and_drop_v2.py:157
msgid "After All Attempts"
msgstr "Após todas as tentativas"

#: drag_and_drop_v2.py:158
msgid "After All Attempts or Correct"
msgstr "Após todas as tentativas ou se estiver correto"

#: drag_and_drop_v2.py:159
msgid "Attempted"
msgstr "Tentado"

#: drag_and_drop_v2.py:165
msgid "Problem Weight"
msgstr "Peso do problema"

#: drag_and_drop_v2.py:166
msgid "Defines the number of points the problem is worth."
msgstr "Define o número de pontos que o problema vale."

#: drag_and_drop_v2.py:173
msgid "Item background color"
msgstr "Cor de fundo do item"

#: drag_and_drop_v2.py:174
msgid ""
"The background color of draggable items in the problem (example: 'blue' or "
"'#0000ff')."
msgstr ""
"A cor de fundo dos itens arrastáveis no problema (exemplo: 'blue' ou "
"'#0000ff')."

#: drag_and_drop_v2.py:181
msgid "Item text color"
msgstr "Cor do texto do item"

#: drag_and_drop_v2.py:182
msgid "Text color to use for draggable items (example: 'white' or '#ffffff')."
msgstr ""
"Cor do texto para usar nos itens arrastáveis (exemplo: 'white' ou "
"'#ffffff')."

#: drag_and_drop_v2.py:189
msgid "Maximum items per zone"
msgstr "Número máximo de itens por zona"

#: drag_and_drop_v2.py:190
msgid ""
"This setting limits the number of items that can be dropped into a single "
"zone."
msgstr ""
"Esta configuração limita o número de itens que podem ser colocados numa "
"única zona."

#: drag_and_drop_v2.py:197
msgid "Problem data"
msgstr "Dados do problema"

#: drag_and_drop_v2.py:199
msgid ""
"Information about zones, items, feedback, explanation and background image "
"for this problem. This information is derived from the input that a course "
"author provides via the interactive editor when configuring the problem."
msgstr ""
"Informações sobre zonas, itens, feedback, explicação e imagem de fundo deste"
" problema. Estas informações são obtidas a partir dos dados que o autor do "
"curso fornece através do editor interativo ao configurar o problema."

#: drag_and_drop_v2.py:209
msgid ""
"Information about current positions of items that a learner has dropped on "
"the target image."
msgstr ""
"Informações sobre as posições atuais dos itens que um aluno colocou na "
"imagem-alvo."

#: drag_and_drop_v2.py:216
msgid "Number of attempts learner used"
msgstr "Número de tentativas utilizadas pelo aluno"

#: drag_and_drop_v2.py:223
msgid "Indicates whether a learner has completed the problem at least once"
msgstr "Indica se um aluno já completou o problema pelo menos uma vez"

#: drag_and_drop_v2.py:230
msgid ""
"DEPRECATED. Keeps maximum score achieved by student as a weighted value."
msgstr ""
"DESCONTINUADO. Guarda a pontuação máxima alcançada pelo aluno como um valor "
"ponderado."

#: drag_and_drop_v2.py:236
msgid ""
"Keeps maximum score achieved by student as a raw value between 0 and 1."
msgstr ""
"Guarda a pontuação máxima alcançada pelo aluno como um valor bruto entre 0 e"
" 1."

#: drag_and_drop_v2.py:243
msgid "Maximum score available of the problem as a raw value between 0 and 1."
msgstr ""
"Pontuação máxima disponível para o problema como um valor bruto entre 0 e 1."

#: drag_and_drop_v2.py:566
#, python-brace-format
msgid "Unknown DnDv2 mode {mode} - course is misconfigured"
msgstr "Modo DnDv2 desconhecido {mode} - o curso está mal configurado"

#: drag_and_drop_v2.py:641
msgid "show_answer handler should only be called for assessment mode"
msgstr ""
"O manipulador show_answer deve ser chamado apenas no modo de avaliação"

#: drag_and_drop_v2.py:646
msgid "The answer is unavailable"
msgstr "A resposta não está disponível"

#: drag_and_drop_v2.py:832
msgid "do_attempt handler should only be called for assessment mode"
msgstr "O manipulador do_attempt deve ser chamado apenas no modo de avaliação"

#: drag_and_drop_v2.py:837 drag_and_drop_v2.py:955
msgid "Max number of attempts reached"
msgstr "Número máximo de tentativas atingido"

#: drag_and_drop_v2.py:842
msgid "Submission deadline has passed."
msgstr "O prazo para submissão expirou."

