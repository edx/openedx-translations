#: default_data.py:5
msgid ""
"An isosceles triangle with three layers of similar height. It is shown "
"upright, so the widest layer is located at the bottom, and the narrowest "
"layer is located at the top."
msgstr ""
"Un triángulo isósceles con tres capas de altura similar. Se muestra en "
"posición vertical, por lo que la capa más ancha se encuentra en la parte "
"inferior y la más estrecha en la parte superior."

#: default_data.py:14
msgid "The Top Zone"
msgstr "La Zona Superior"

#: default_data.py:15
msgid "The Middle Zone"
msgstr "La Zona Intermedia"

#: default_data.py:16
msgid "The Bottom Zone"
msgstr "La Zona Inferior"

#: default_data.py:18
msgid "Use this zone to associate an item with the top layer of the triangle."
msgstr ""
"Utiliza esta zona para asociar un elemento con la capa superior del "
"triángulo."

#: default_data.py:19
msgid ""
"Use this zone to associate an item with the middle layer of the triangle."
msgstr ""
"Utiliza esta zona para asociar un elemento con la capa intermedia del "
"triángulo."

#: default_data.py:20
msgid ""
"Use this zone to associate an item with the bottom layer of the triangle."
msgstr ""
"Utiliza esta zona para asociar un elemento con la capa inferior del "
"triángulo."

#: default_data.py:22
msgid "Correct! This one belongs to The Top Zone."
msgstr "¡Correcto! Este pertenece a la Zona Superior."

#: default_data.py:23
msgid "Correct! This one belongs to The Middle Zone."
msgstr "¡Correcto! Este pertenece a la Zona Intermedia."

#: default_data.py:24
msgid "Correct! This one belongs to The Bottom Zone."
msgstr "¡Correcto! Este pertenece a la Zona Inferior."

#: default_data.py:25
msgid "No, this item does not belong here. Try again."
msgstr "No, este elemento no pertenece aquí. Inténtalo de nuevo."

#: default_data.py:26
msgid "You silly, there are no zones for this one."
msgstr "¡Qué tonto, no hay zonas para este!"

#: default_data.py:27
msgid "Of course it goes here! It goes anywhere!"
msgstr "¡Por supuesto que va aquí! ¡Va a cualquier lugar!"

#: default_data.py:29
msgid "Goes to the top"
msgstr "Va a la parte superior"

#: default_data.py:30
msgid "Goes to the middle"
msgstr "Va a la parte intermedia"

#: default_data.py:31
msgid "Goes to the bottom"
msgstr "Va a la parte inferior"

#: default_data.py:32
msgid "Goes anywhere"
msgstr "Va a cualquier lugar"

#: default_data.py:33
msgid "I don't belong anywhere"
msgstr "No pertenezco a ningún lugar."

#: default_data.py:35
msgid "Drag the items onto the image above."
msgstr "Arrastra los elementos sobre la imagen de arriba."

#: default_data.py:36
msgid "Good work! You have completed this drag and drop problem."
msgstr "¡Buen trabajo! Has completado este problema de arrastrar y soltar."

#: drag_and_drop_v2.py:82
msgid "Title"
msgstr "Título"

#: drag_and_drop_v2.py:83
msgid ""
"The title of the drag and drop problem. The title is displayed to learners."
msgstr ""
"El título del problema de arrastrar y soltar. El título se muestra a los "
"estudiantes."

#: drag_and_drop_v2.py:85
msgid "Drag and Drop"
msgstr "Arrastrar y Soltar"

#: drag_and_drop_v2.py:90
msgid "Mode"
msgstr "Modo"

#: drag_and_drop_v2.py:92
msgid ""
"Standard mode: the problem provides immediate feedback each time a learner "
"drops an item on a target zone. Assessment mode: the problem provides "
"feedback only after a learner drops all available items on target zones."
msgstr ""
"Modo estándar: el problema proporciona retroalimentación inmediata cada vez "
"que un estudiante deja caer un elemento en una zona objetivo. Modo de "
"evaluación: el problema proporciona retroalimentación solo después de que un"
" estudiante haya depositado todos los elementos disponibles en las zonas "
"objetivo."

#: drag_and_drop_v2.py:99
msgid "Standard"
msgstr "Estándar"

#: drag_and_drop_v2.py:100
msgid "Assessment"
msgstr "Evaluación"

#: drag_and_drop_v2.py:107
msgid "Maximum attempts"
msgstr "Intentos máximos"

#: drag_and_drop_v2.py:109
msgid ""
"Defines the number of times a student can try to answer this problem. If the"
" value is not set, infinite attempts are allowed."
msgstr ""
"Define la cantidad de veces que un estudiante puede intentar responder este "
"problema. Si no se establece un valor, se permiten intentos infinitos."

#: drag_and_drop_v2.py:118
msgid "Show title"
msgstr "Mostrar título"

#: drag_and_drop_v2.py:119
msgid "Display the title to the learner?"
msgstr "¿Mostrar el título al estudiante?"

#: drag_and_drop_v2.py:126
msgid "Problem text"
msgstr "Texto del problema"

#: drag_and_drop_v2.py:127
msgid "The description of the problem or instructions shown to the learner."
msgstr ""
"La descripción del problema o las instrucciones que se muestran al "
"estudiante."

#: drag_and_drop_v2.py:134
msgid "Show \"Problem\" heading"
msgstr "Mostrar el encabezado \"Problema\""

#: drag_and_drop_v2.py:135
msgid "Display the heading \"Problem\" above the problem text?"
msgstr "¿Mostrar el encabezado \"Problema\" por encima del texto del problema?"

#: drag_and_drop_v2.py:141
msgid "Show answer"
msgstr "Mostrar respuesta"

#: drag_and_drop_v2.py:142
msgid ""
"Defines when to show the answer to the problem. A default value can be set "
"in Advanced Settings. To revert setting a custom value, choose the 'Default'"
" option."
msgstr ""
"Define cuándo mostrar la respuesta al problema. Se puede establecer un valor"
" predeterminado en Configuración avanzada. Para revertir la configuración de"
" un valor personalizado, elige la opción 'Predeterminado'."

#: drag_and_drop_v2.py:148
msgid "Default"
msgstr "Predeterminado"

#: drag_and_drop_v2.py:149
msgid "Always"
msgstr "Siempre"

#: drag_and_drop_v2.py:150
msgid "Answered"
msgstr "Respondido"

#: drag_and_drop_v2.py:151
msgid "Attempted or Past Due"
msgstr "Intentado o Vencido"

#: drag_and_drop_v2.py:152
msgid "Closed"
msgstr "Cerrado"

#: drag_and_drop_v2.py:153
msgid "Finished"
msgstr "Finalizado"

#: drag_and_drop_v2.py:154
msgid "Correct or Past Due"
msgstr "Correcto o Vencido"

#: drag_and_drop_v2.py:155
msgid "Past Due"
msgstr "Vencido"

#: drag_and_drop_v2.py:156
msgid "Never"
msgstr "Nunca"

#: drag_and_drop_v2.py:157
msgid "After All Attempts"
msgstr "Después de todos los intentos"

#: drag_and_drop_v2.py:158
msgid "After All Attempts or Correct"
msgstr "Después de todos los intentos o si es correcto"

#: drag_and_drop_v2.py:159
msgid "Attempted"
msgstr "Intentado"

#: drag_and_drop_v2.py:165
msgid "Problem Weight"
msgstr "Peso del problema"

#: drag_and_drop_v2.py:166
msgid "Defines the number of points the problem is worth."
msgstr "Define la cantidad de puntos que vale el problema."

#: drag_and_drop_v2.py:173
msgid "Item background color"
msgstr "Color de fondo del elemento"

#: drag_and_drop_v2.py:174
msgid ""
"The background color of draggable items in the problem (example: 'blue' or "
"'#0000ff')."
msgstr ""
"El color de fondo de los elementos arrastrables en el problema (ejemplo: "
"'blue' o '#0000ff')."

#: drag_and_drop_v2.py:181
msgid "Item text color"
msgstr "Color del texto del elemento"

#: drag_and_drop_v2.py:182
msgid "Text color to use for draggable items (example: 'white' or '#ffffff')."
msgstr ""
"Color del texto a utilizar para los elementos arrastrables (ejemplo: 'white'"
" o '#ffffff')."

#: drag_and_drop_v2.py:189
msgid "Maximum items per zone"
msgstr "Máximo de elementos por zona"

#: drag_and_drop_v2.py:190
msgid ""
"This setting limits the number of items that can be dropped into a single "
"zone."
msgstr ""
"Esta configuración limita la cantidad de elementos que se pueden colocar en "
"una sola zona."

#: drag_and_drop_v2.py:197
msgid "Problem data"
msgstr "Datos del problema"

#: drag_and_drop_v2.py:199
msgid ""
"Information about zones, items, feedback, explanation and background image "
"for this problem. This information is derived from the input that a course "
"author provides via the interactive editor when configuring the problem."
msgstr ""
"Información sobre zonas, elementos, retroalimentación, explicación e imagen "
"de fondo para este problema. Esta información se deriva de los datos que el "
"autor del curso proporciona a través del editor interactivo al configurar el"
" problema."

#: drag_and_drop_v2.py:209
msgid ""
"Information about current positions of items that a learner has dropped on "
"the target image."
msgstr ""
"Información sobre las posiciones actuales de los elementos que un estudiante"
" ha colocado en la imagen objetivo."

#: drag_and_drop_v2.py:216
msgid "Number of attempts learner used"
msgstr "Número de intentos utilizados por el estudiante"

#: drag_and_drop_v2.py:223
msgid "Indicates whether a learner has completed the problem at least once"
msgstr "Indica si un estudiante ha completado el problema al menos una vez"

#: drag_and_drop_v2.py:230
msgid ""
"DEPRECATED. Keeps maximum score achieved by student as a weighted value."
msgstr ""
"DEPRECATED. Guarda la puntuación máxima lograda por el estudiante como un "
"valor ponderado."

#: drag_and_drop_v2.py:236
msgid ""
"Keeps maximum score achieved by student as a raw value between 0 and 1."
msgstr ""
"Guarda la puntuación máxima lograda por el estudiante como un valor bruto "
"entre 0 y 1."

#: drag_and_drop_v2.py:243
msgid "Maximum score available of the problem as a raw value between 0 and 1."
msgstr ""
"Puntuación máxima disponible del problema como un valor bruto entre 0 y 1."

#: drag_and_drop_v2.py:566
#, python-brace-format
msgid "Unknown DnDv2 mode {mode} - course is misconfigured"
msgstr "Modo DnDv2 desconocido {mode} - el curso está mal configurado"

#: drag_and_drop_v2.py:641
msgid "show_answer handler should only be called for assessment mode"
msgstr ""
"El manejador de mostrar respuesta solo debe llamarse en modo de evaluación"

#: drag_and_drop_v2.py:646
msgid "The answer is unavailable"
msgstr "La respuesta no está disponible"

#: drag_and_drop_v2.py:832
msgid "do_attempt handler should only be called for assessment mode"
msgstr "El manejador de intento solo debe llamarse en modo de evaluación"

#: drag_and_drop_v2.py:837 drag_and_drop_v2.py:955
msgid "Max number of attempts reached"
msgstr "Se alcanzó el número máximo de intentos"

#: drag_and_drop_v2.py:842
msgid "Submission deadline has passed."
msgstr "La fecha límite de entrega ha pasado."

