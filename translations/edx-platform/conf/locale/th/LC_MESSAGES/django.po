#. released for viewing.
#: xmodule/graders.py:403
#, python-brace-format
msgid "{section_type} {index} Unreleased - 0% (?/?)"
msgstr "{section_type} {index} ยังไม่เผยแพร่ - 0% (?/?)"

#: xmodule/graders.py:417
#, python-brace-format
msgid "The lowest {drop_count} {section_type} scores are dropped."
msgstr ""
"คะแนน {section_type} ที่ต่ำที่สุดจำนวน {drop_count} คะแนนจะไม่นำมาคำนวณ"

#. Translators: "Homework Average = 0%"
#: xmodule/graders.py:436
#, python-brace-format
msgid "{section_type} Average = {percent:.2%}"
msgstr "คะแนนเฉลี่ย {section_type} = {percent:.2%}"

#. Translators: Avg is short for Average
#: xmodule/graders.py:441
#, python-brace-format
msgid "{short_label} Avg"
msgstr "ค่าเฉลี่ย {short_label}"

#: xmodule/hidden_block.py:38
#, python-brace-format
msgid ""
"ERROR: \"{block_type}\" is an unknown component type. This component will be"
" hidden in LMS."
msgstr ""
"ข้อผิดพลาด: \"{block_type}\" เป็นประเภทองค์ประกอบที่ไม่รู้จัก "
"องค์ประกอบนี้จะถูกซ่อนใน LMS"

#: xmodule/html_block.py:63 xmodule/html_block.py:383
#: xmodule/html_block.py:443
msgid "Html contents to display for this block"
msgstr "เนื้อหา HTML ที่จะแสดงสำหรับบล็อกนี้"

#: xmodule/html_block.py:65
msgid "Upstream html contents to store upstream data field"
msgstr "เนื้อหา HTML ต้นทางที่จะจัดเก็บในช่องข้อมูลต้นทาง"

#: xmodule/html_block.py:72
msgid "Source code for LaTeX documents. This feature is not well-supported."
msgstr "ซอร์สโค้ดสำหรับเอกสาร LaTeX ฟีเจอร์นี้ไม่ได้รับการรองรับอย่างเต็มที่"

#: xmodule/html_block.py:82
msgid ""
"Select Visual to enter content and have the editor automatically create the "
"HTML. Select Raw to edit HTML directly. If you change this setting, you must"
" save the component and then re-open it for editing."
msgstr ""
"เลือกแบบภาพเพื่อป้อนเนื้อหาและให้เครื่องมือแก้ไขสร้าง HTML โดยอัตโนมัติ "
"เลือกแบบดิบเพื่อแก้ไข HTML โดยตรง หากเปลี่ยนการตั้งค่านี้ "
"คุณต้องบันทึกองค์ประกอบแล้วเปิดใหม่เพื่อแก้ไข"

#: xmodule/html_block.py:85
msgid "Editor"
msgstr "เครื่องมือแก้ไข"

#: xmodule/html_block.py:88
msgid "Visual"
msgstr "แบบภาพ"

#: xmodule/html_block.py:89
msgid "Raw"
msgstr "แบบดิบ"

#: xmodule/html_block.py:409
msgid "Hide Page From Learners"
msgstr "ซ่อนหน้าจากผู้เรียน"

#: xmodule/html_block.py:410
msgid ""
"If you select this option, only course team members with the Staff or Admin "
"role see this page."
msgstr ""
"หากเลือกตัวเลือกนี้ "
"เฉพาะสมาชิกทีมหลักสูตรที่มีบทบาทเจ้าหน้าที่หรือผู้ดูแลระบบเท่านั้นที่จะเห็นหน้านี้"

#: xmodule/html_block.py:420
msgid "HTML for the additional pages"
msgstr "HTML สำหรับหน้าเพิ่มเติม"

#: xmodule/html_block.py:438
msgid "List of course update items"
msgstr "รายการอัปเดตหลักสูตร"

#: xmodule/item_bank_block.py:68
msgid "Count"
msgstr "จำนวน"

#: xmodule/item_bank_block.py:69
msgid ""
"Enter the number of components to display to each student. Set it to -1 to "
"display all components."
msgstr ""
"ป้อนจำนวนองค์ประกอบที่จะแสดงให้ผู้เรียนแต่ละคน ตั้งค่าเป็น -1 "
"เพื่อแสดงองค์ประกอบทั้งหมด"

#: xmodule/item_bank_block.py:82
msgid ""
"Determines whether a 'Reset Problems' button is shown, so users may reset "
"their answers and reshuffle selected items."
msgstr ""
"กำหนดว่าจะแสดงปุ่ม 'รีเซ็ตโจทย์' หรือไม่ "
"เพื่อให้ผู้ใช้รีเซ็ตคำตอบและสุ่มรายการที่เลือกใหม่ได้"

#: xmodule/item_bank_block.py:480
#, python-brace-format
msgid ""
"The problem bank has been configured to show {count} problems. Please "
"specify a positive number of problems, or specify -1 to show all problems."
msgstr ""
"คลังโจทย์ถูกกำหนดให้แสดงโจทย์ {count} ข้อ โปรดระบุจำนวนโจทย์เป็นจำนวนบวก "
"หรือระบุ -1 เพื่อแสดงโจทย์ทั้งหมด"

#: xmodule/item_bank_block.py:484 xmodule/item_bank_block.py:496
msgid "Edit the problem bank configuration."
msgstr "แก้ไขการกำหนดค่าคลังโจทย์"

#: xmodule/item_bank_block.py:492
#, python-brace-format
msgid ""
"The problem bank has been configured to show {count} problems, but only "
"{actual} have been selected."
msgstr ""
"คลังโจทย์ถูกกำหนดให้แสดงโจทย์ {count} ข้อ แต่เลือกไว้เพียง {actual} ข้อ"

#: xmodule/library_content_block.py:57
msgid "Any Type"
msgstr "ทุกประเภท"

#: xmodule/library_content_block.py:89 cms/templates/widgets/header.html:263
msgid "Library"
msgstr "คลัง"

#: xmodule/library_content_block.py:90
msgid "Select the library from which you want to draw content."
msgstr "เลือกคลังที่ต้องการดึงเนื้อหา"

#: xmodule/library_content_block.py:96
msgid "Library Version"
