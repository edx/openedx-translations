msgstr "Publicación en una fecha determinada"

#: cms/templates/howitworks.html:206
#, python-brace-format
msgid ""
"Simply set the date of a section or subsection, and {studio_name} will "
"publish it to your students for you."
msgstr ""
"Solo tienes que establecer la fecha de una sección o subsección y "
