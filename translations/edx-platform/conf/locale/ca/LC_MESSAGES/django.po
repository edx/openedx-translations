msgstr ""
"Especifica si el vídeo pot ser accessible públicament pels estudiants."

#: xmodule/video_block/video_xfields.py:224
msgid "Public Access"
msgstr "Accés públic"

#: xmodule/video_block/video_xfields.py:231
