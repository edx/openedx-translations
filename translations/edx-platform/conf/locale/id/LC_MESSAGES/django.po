msgstr ""
"Jumlah maksimum kata yang ditampilkan dalam awan kata yang dihasilkan."

#: xmodule/word_cloud_block.py:88
msgid "Show Percents"
msgstr "Tampilkan Persentase"

#: xmodule/word_cloud_block.py:89
