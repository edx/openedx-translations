msgstr ""
"Statistik untuk kata yang dimasukkan ditampilkan di dekat kata tersebut."

#: xmodule/word_cloud_block.py:96
msgid "Whether this learner has posted words to the cloud."
msgstr "Apakah peserta ini telah mengirimkan kata ke awan kata."

#: xmodule/word_cloud_block.py:101
