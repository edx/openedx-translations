msgstr "Απαιτείται περιγραφή των στόχων σας"

#: openedx/core/djangoapps/user_authn/views/registration_form.py:210
msgid "A city is required"
msgstr "Απαιτείται πόλη"

#: openedx/core/djangoapps/user_authn/views/registration_form.py:211
msgid "A country is required"
msgstr "Απαιτείται χώρα"

#: openedx/core/djangoapps/user_authn/views/registration_form.py:219
msgid "To enroll, you must follow the honor code."
msgstr "Για να εγγραφείτε, πρέπει να τηρείτε τον κώδικα τιμής."

#: openedx/core/djangoapps/user_authn/views/registration_form.py:227
msgid "You are missing one or more required fields"
msgstr "Λείπουν ένα ή περισσότερα υποχρεωτικά πεδία"

#: openedx/core/djangoapps/user_authn/views/registration_form.py:279
msgid "Unauthorized email address."
msgstr "Μη εξουσιοδοτημένη διεύθυνση email."

#: openedx/core/djangoapps/user_authn/views/registration_form.py:283
#, python-brace-format
msgid ""
"It looks like {email} belongs to an existing account. Try again with a "
"different email address."
msgstr ""
"Φαίνεται ότι η διεύθυνση {email} ανήκει σε έναν υπάρχοντα λογαριασμό. "
"Δοκιμάστε ξανά με διαφορετική διεύθυνση email."

#: openedx/core/djangoapps/user_authn/views/registration_form.py:319
