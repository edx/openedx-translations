msgstr "Εγγραφή"

#: openedx/core/djangoapps/user_authn/views/login.py:286
#: openedx/core/djangoapps/user_authn/views/login.py:291
#: openedx/core/djangoapps/user_authn/views/login.py:304
#: openedx/core/djangoapps/user_authn/views/login.py:308
