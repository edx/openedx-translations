msgid "The provided access_token is not valid."
msgstr "Το access_token που δόθηκε δεν είναι έγκυρο."

#: openedx/core/djangoapps/user_authn/views/registration_form.py:115
msgid "Full Name cannot contain the following characters: < >"
msgstr ""
"Το ονοματεπώνυμο δεν μπορεί να περιέχει τους ακόλουθους χαρακτήρες: < >"

