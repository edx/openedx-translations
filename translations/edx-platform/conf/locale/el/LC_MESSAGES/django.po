#, python-format
msgid "Email cannot be more than %(limit_value)s characters long"
msgstr ""
"Η διεύθυνση email δεν μπορεί να υπερβαίνει τους %(limit_value)s χαρακτήρες"

#: openedx/core/djangoapps/user_authn/views/registration_form.py:201
msgid "You must accept the terms of service."
msgstr "Πρέπει να αποδεχτείτε τους όρους παροχής υπηρεσιών."

#: openedx/core/djangoapps/user_authn/views/registration_form.py:205
msgid "A level of education is required"
msgstr "Απαιτείται επίπεδο εκπαίδευσης"

#: openedx/core/djangoapps/user_authn/views/registration_form.py:206
msgid "Your gender is required"
msgstr "Απαιτείται το φύλο σας"

#: openedx/core/djangoapps/user_authn/views/registration_form.py:207
msgid "Your year of birth is required"
msgstr "Απαιτείται το έτος γέννησής σας"

#: openedx/core/djangoapps/user_authn/views/registration_form.py:208
