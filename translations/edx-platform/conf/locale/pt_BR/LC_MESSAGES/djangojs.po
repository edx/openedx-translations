msgstr "Certifique-se de que todo o seu rosto esteja dentro do enquadramento"

#: lms/templates/verify_student/incourse_reverify.underscore:20
#, python-brace-format
msgid ""
"Once in position, use the Take Photo button {icon} to capture your photo"
msgstr ""
"Uma vez posicionado, use o botão Tirar Foto {icon} para capturar sua foto"

