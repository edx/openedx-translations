#: cms/templates/library.html:93
msgid "Using library content in courses"
msgstr "Utilizando conteúdo da biblioteca em cursos"

#: cms/templates/library.html:94
#, python-brace-format
msgid ""
"Use library content in courses by adding the "
"{em_start}library_content{em_end} policy key to the Advanced Module List in "
"the course's Advanced Settings, then adding a Randomized Content Block to "
"your courseware. In the settings for each Randomized Content Block, select "
"this library as the source library, and specify the number of problems to be"
" randomly selected and displayed to each student."
msgstr ""
"Utilize o conteúdo da biblioteca em cursos adicionando a chave de política "
"{em_start}library_content{em_end} à Lista de Módulos Avançados nas "
"Configurações Avançadas do curso, em seguida, adicionando um Bloco de "
"Conteúdo Aleatório ao seu curso. Nas configurações de cada Bloco de Conteúdo"
" Aleatório, selecione esta biblioteca como biblioteca de origem e "
"especifique o número de questões a serem selecionadas e exibidas "
"aleatoriamente para cada aluno."

