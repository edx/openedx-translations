msgid_plural "but there are only {actual} matching problems."
msgstr[0] "но существует только {actual} подходящая задача."
msgstr[1] "но существует только {actual} подходящие задачи."
msgstr[2] "но существует только {actual} подходящих задач."
msgstr[3] "но существует только {actual} подходящие задачи."

