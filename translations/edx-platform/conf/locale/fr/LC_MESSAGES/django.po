msgstr "Fichier texte (.txt)"

#: xmodule/video_block/video_xfields.py:154
msgid "The last speed that the user specified for the video."
msgstr "La dernière vitesse choisie par l'utilisateur pour la vidéo."

#: xmodule/video_block/video_xfields.py:158
msgid "The default speed for the video."
msgstr "La vitesse par défaut de la vidéo."

#: xmodule/video_block/video_xfields.py:163
msgid ""
"Specify whether to advance automatically to the next unit when the video "
"ends."
msgstr ""
"Indiquez s'il faut passer automatiquement à l'unité suivante à la fin de la "
"vidéo."

#: xmodule/video_block/video_xfields.py:172
msgid "Specify whether YouTube is available for the user."
msgstr "Indiquez si YouTube est accessible à l'utilisateur."

#: xmodule/video_block/video_xfields.py:177
msgid ""
"Upload a handout to accompany this video. Students can download the handout "
"by clicking Download Handout under the video."
msgstr ""
"Téléversez un document pour accompagner cette vidéo. Les étudiants peuvent "
"le télécharger en cliquant sur Télécharger le document sous la vidéo."

#: xmodule/video_block/video_xfields.py:179
msgid "Upload Handout"
msgstr "Téléverser un document"

#: xmodule/video_block/video_xfields.py:183
msgid ""
"Upload an audio description file that replaces the video's original audio "
"for accessibility."
msgstr ""
"Téléversez un fichier d'audiodescription qui remplace la piste audio "
"originale de la vidéo à des fins d'accessibilité."

