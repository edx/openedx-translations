msgstr ""
"Facultatif, pour les anciens navigateurs : l'identifiant YouTube de la vidéo"
" à vitesse 0,75x."

#: xmodule/video_block/video_xfields.py:41
msgid "YouTube ID for .75x speed"
msgstr "Identifiant YouTube pour la vitesse 0,75x"

#: xmodule/video_block/video_xfields.py:46
