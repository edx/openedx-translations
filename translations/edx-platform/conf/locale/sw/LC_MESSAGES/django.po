msgstr "(kwa ajili ya usajili na ufikiaji wa wanafunzi)"

#: cms/templates/settings.html:103
#, python-brace-format
msgid "Enroll in {course_display_name}"
msgstr "Jisajili katika {course_display_name}"

#: cms/templates/settings.html:106
#, python-brace-format
msgid ""
"The course \"{course_display_name}\", provided by {platform_name}, is open "
"for enrollment. Please navigate to this course at {link_for_about_page} to "
"enroll."
msgstr ""
"Kozi \"{course_display_name}\", inayotolewa na {platform_name}, imefunguliwa"
" kwa ajili ya usajili. Tafadhali nenda kwenye kozi hii kupitia "
"{link_for_about_page} ili kujisajili."

#: cms/templates/settings.html:112
msgid "Send a note to students via email"
msgstr "Tuma ujumbe kwa wanafunzi kupitia barua pepe"

#: cms/templates/settings.html:114
msgid "Invite your students"
msgstr "Alika wanafunzi wako"

#: cms/templates/settings.html:122
#, python-brace-format
msgid "Promoting Your Course with {platform_name}"
msgstr "Kutangaza Kozi Yako na {platform_name}"

#: cms/templates/settings.html:125
msgid ""
"Your course summary page will not be viewable until your course has been "
"announced. To provide content for the page and preview it, follow the "
"instructions provided by your Program Manager."
msgstr ""
"Ukurasa wa muhtasari wa kozi yako hautakuwa unaoonekana hadi kozi yako "
"itangazewe. Ili kutoa yaliyomo kwa ukurasa huo na kuiangalia awali, fuata "
"maelekezo yaliyotolewa na Meneja wako wa Programu."

#: cms/templates/settings.html:129
msgid ""
"Please note that changes here may take up to a business day to appear on "
"your course summary page."
msgstr ""
"Tafadhali kumbuka kuwa mabadiliko hapa yanaweza kuchukua hadi siku ya "
"biashara kuonekana kwenye ukurasa wa muhtasari wa kozi yako."

