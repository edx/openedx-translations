msgstr "Wörterbuch zur Verwaltung des Zustands von Eingabetypen"

#: xmodule/capa_block.py:297
msgid "Dictionary with the current student responses"
msgstr "Wörterbuch mit den aktuellen Schülerantworten"

#: xmodule/capa_block.py:299
