msgstr ""
"Laden Sie ein Handout hoch, das dieses Video begleitet. Studenten können das"
" Handout herunterladen, indem sie unter dem Video auf \"Download Handout\" "
"klicken."

#: xmodule/video_block/video_xfields.py:179
msgid "Upload Handout"
msgstr "Handout hochladen"

