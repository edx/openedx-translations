#: api.py:125
msgid ""
"The CSV does not match this problem. Check that you uploaded the right CSV."
msgstr ""
"Το CSV δεν ταιριάζει με αυτό το πρόβλημα. Ελέγξτε ότι ανεβάσατε το σωστό "
"CSV."

#: api.py:130
msgid "Points must be numbers."
msgstr "Οι πόντοι πρέπει να είναι αριθμοί."

#: api.py:132
msgid "Points must not be greater than {}."
msgstr "Οι πόντοι δεν πρέπει να είναι μεγαλύτεροι από {}."

#: api.py:134
msgid "Points must be greater than 0"
msgstr "Οι πόντοι πρέπει να είναι μεγαλύτεροι από 0"

#: api.py:351
msgid "Wrong course id {} != {}"
msgstr "Λάθος αναγνωριστικό μαθήματος {} != {}"

#: api.py:367
msgid "The file has no data rows."
msgstr "Το αρχείο δεν περιέχει γραμμές δεδομένων."

#: api.py:370
msgid ""
"No grades were changed. Enter grades in a \"new_override\" column and upload"
" the file again."
msgstr ""
"Δεν άλλαξε κανένας βαθμός. Εισαγάγετε βαθμούς σε μια στήλη \"new_override\" "
"και μεταφορτώστε ξανά το αρχείο."

#: api.py:383 api.py:385
msgid "Repeated user_id: "
msgstr "Επαναλαμβανόμενο user_id: "

#: api.py:402
msgid "Grade must be a number"
msgstr "Ο βαθμός πρέπει να είναι αριθμός"

#: api.py:405
msgid "Grade must not be negative"
msgstr "Ο βαθμός δεν πρέπει να είναι αρνητικός"

#: api.py:666
msgid "score must be positive"
msgstr "η βαθμολογία πρέπει να είναι θετική"
