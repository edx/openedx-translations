#: api.py:125
msgid ""
"The CSV does not match this problem. Check that you uploaded the right CSV."
msgstr "CSV hailingani na tatizo hili. Hakikisha kuwa umepakia CSV sahihi."

#: api.py:130
msgid "Points must be numbers."
msgstr "Pointi lazima ziwe nambari."

#: api.py:132
msgid "Points must not be greater than {}."
msgstr "Alama hazipaswi kuwa kubwa kuliko {}."

#: api.py:134
msgid "Points must be greater than 0"
msgstr "Alama lazima ziwe kubwa kuliko 0"

#: api.py:351
msgid "Wrong course id {} != {}"
msgstr "Kitambulisho cha kozi si sahihi {} != {}"

#: api.py:367
msgid "The file has no data rows."
msgstr "Faili halina safu mlalo za data."

#: api.py:370
msgid ""
"No grades were changed. Enter grades in a \"new_override\" column and upload"
" the file again."
msgstr ""
"Hakuna alama zilizobadilishwa. Weka alama katika safu wima ya "
"\"new_override\" na upakie faili tena."

#: api.py:383 api.py:385
msgid "Repeated user_id: "
msgstr "User_id iliyorudiwa: "

#: api.py:402
msgid "Grade must be a number"
msgstr "Daraja lazima iwe nambari"

#: api.py:405
msgid "Grade must not be negative"
msgstr "Daraja lazima lisiwe hasi"

#: api.py:666
msgid "score must be positive"
msgstr "alama lazima ziwe chanya"
