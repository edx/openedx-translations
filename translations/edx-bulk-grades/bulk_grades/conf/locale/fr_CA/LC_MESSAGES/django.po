#: api.py:125
msgid ""
"The CSV does not match this problem. Check that you uploaded the right CSV."
msgstr ""
"Le CSV ne correspond pas à ce problème. Vérifiez que vous avez téléchargé le"
" bon CSV."

#: api.py:130
msgid "Points must be numbers."
msgstr "Les points doivent être des nombres."

#: api.py:132
msgid "Points must not be greater than {}."
msgstr "Les points ne doivent pas être supérieurs à {}."

#: api.py:134
msgid "Points must be greater than 0"
msgstr "Les points doivent être supérieurs à 0"

#: api.py:351
msgid "Wrong course id {} != {}"
msgstr "Mauvais identifiant de cours {} != {}"

#: api.py:367
msgid "The file has no data rows."
msgstr "Le fichier ne contient aucune ligne de données."

#: api.py:370
msgid ""
"No grades were changed. Enter grades in a \"new_override\" column and upload"
" the file again."
msgstr ""
"Aucune note n’a été modifiée. Saisissez les notes dans une colonne « "
"new_override » et téléversez le fichier de nouveau."

#: api.py:383 api.py:385
msgid "Repeated user_id: "
msgstr "user_id répété :"

#: api.py:402
msgid "Grade must be a number"
msgstr "La note doit être un nombre"

#: api.py:405
msgid "Grade must not be negative"
msgstr "La note ne doit pas être négative"

#: api.py:666
msgid "score must be positive"
msgstr "le résultat doit être positif"
