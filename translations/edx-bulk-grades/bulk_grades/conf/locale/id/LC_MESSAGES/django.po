#: api.py:125
msgid ""
"The CSV does not match this problem. Check that you uploaded the right CSV."
msgstr ""
"CSV tidak cocok dengan permasalahan ini. Periksa bahwa Anda mengunggah CSV "
"yang benar."

#: api.py:130
msgid "Points must be numbers."
msgstr "Nilai harus berupa angka."

#: api.py:132
msgid "Points must not be greater than {}."
msgstr "Nilai tidak boleh lebih besar dari {}."

#: api.py:134
msgid "Points must be greater than 0"
msgstr "Nilai harus lebih besar dari 0."

#: api.py:351
msgid "Wrong course id {} != {}"
msgstr "ID kursus salah {} != {}."

#: api.py:367
msgid "The file has no data rows."
msgstr "Berkas tidak memiliki baris data."

#: api.py:370
msgid ""
"No grades were changed. Enter grades in a \"new_override\" column and upload"
" the file again."
msgstr ""
"Tidak ada nilai yang diubah. Masukkan nilai di kolom \"new_override\" dan "
"unggah kembali berkas tersebut."

#: api.py:383 api.py:385
msgid "Repeated user_id: "
msgstr "user_id yang berulang: "

#: api.py:402
msgid "Grade must be a number"
msgstr "Nilai harus berupa angka."

#: api.py:405
msgid "Grade must not be negative"
msgstr "Nilai tidak boleh negatif."

#: api.py:666
msgid "score must be positive"
msgstr "Skor harus positif."
