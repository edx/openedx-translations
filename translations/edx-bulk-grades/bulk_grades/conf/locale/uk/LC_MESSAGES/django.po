#: api.py:125
msgid ""
"The CSV does not match this problem. Check that you uploaded the right CSV."
msgstr ""
"CSV не відповідає цій задачі. Переконайтеся, що ви завантажили правильний "
"файл CSV."

#: api.py:130
msgid "Points must be numbers."
msgstr "Бали мають бути позначені цифрами."

#: api.py:132
msgid "Points must not be greater than {}."
msgstr "Бали не повинні перевищувати {}."

#: api.py:134
msgid "Points must be greater than 0"
msgstr "Бали повинні бути більше 0"

#: api.py:351
msgid "Wrong course id {} != {}"
msgstr "Неправильний ID курсу {} != {}"

#: api.py:367
msgid "The file has no data rows."
msgstr "Файл не містить рядків із даними."

#: api.py:370
msgid ""
"No grades were changed. Enter grades in a \"new_override\" column and upload"
" the file again."
msgstr ""
"Жодну оцінку не змінено. Введіть оцінки в стовпці \"new_override\" і "
"завантажте файл ще раз."

#: api.py:383 api.py:385
msgid "Repeated user_id: "
msgstr " user_id: повторююється"

#: api.py:402
msgid "Grade must be a number"
msgstr "Оцінка має бути числом"

#: api.py:405
msgid "Grade must not be negative"
msgstr "Оцінка не може бути менше нуля"

#: api.py:666
msgid "score must be positive"
msgstr "оцінка має бути більше нуля"
