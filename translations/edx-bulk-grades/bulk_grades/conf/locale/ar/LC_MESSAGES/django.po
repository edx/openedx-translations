#: api.py:125
msgid ""
"The CSV does not match this problem. Check that you uploaded the right CSV."
msgstr ""
"لا يتطابق ملف CSV مع هذه المشكلة. تأكد من أنك قمت بتحميل ملف CSV الصحيح."

#: api.py:130
msgid "Points must be numbers."
msgstr "يجب أن تُكتب الدرجات بالأرقام."

#: api.py:132
msgid "Points must not be greater than {}."
msgstr "يجب ألّا تكون الدرجات أكبر من {}."

#: api.py:134
msgid "Points must be greater than 0"
msgstr "يجب أن تكون الدرجات أكبر من 0"

#: api.py:351
msgid "Wrong course id {} != {}"
msgstr "معرف الدورة التدريبية خاطئ {} != {}"

#: api.py:367
msgid "The file has no data rows."
msgstr "لا يحتوي الملف على صفوف بيانات."

#: api.py:370
msgid ""
"No grades were changed. Enter grades in a \"new_override\" column and upload"
" the file again."
msgstr "لم تتغير أي درجات. أدخل الدرجات في عمود \"new_override\" وأعد رفع الملف."

#: api.py:383 api.py:385
msgid "Repeated user_id: "
msgstr "معرف المستخدم المتكرر: "

#: api.py:402
msgid "Grade must be a number"
msgstr "يجب أن تكون الدرجة رقمًا"

#: api.py:405
msgid "Grade must not be negative"
msgstr "يجب ألا تكون الدرجة سلبية"

#: api.py:666
msgid "score must be positive"
msgstr "يجب أن تكون النتيجة إيجابية"
