#: api.py:125
msgid ""
"The CSV does not match this problem. Check that you uploaded the right CSV."
msgstr ""
"Il CSV non corrisponde a questo problema. Verifica di aver caricato il CSV "
"corretto."

#: api.py:130
msgid "Points must be numbers."
msgstr "I punti devono essere numeri."

#: api.py:132
msgid "Points must not be greater than {}."
msgstr "I punti non devono essere maggiori di {}."

#: api.py:134
msgid "Points must be greater than 0"
msgstr "I punti devono essere maggiori di 0"

#: api.py:351
msgid "Wrong course id {} != {}"
msgstr "ID corso errato {} != {}"

#: api.py:367
msgid "The file has no data rows."
msgstr "Il file non contiene righe di dati."

#: api.py:370
msgid ""
"No grades were changed. Enter grades in a \"new_override\" column and upload"
" the file again."
msgstr ""
"Nessun voto è stato modificato. Inserisci i voti in una colonna "
"\"new_override\" e carica di nuovo il file."

#: api.py:383 api.py:385
msgid "Repeated user_id: "
msgstr "user_id ripetuto: "

#: api.py:402
msgid "Grade must be a number"
msgstr "Il voto deve essere un numero"

#: api.py:405
msgid "Grade must not be negative"
msgstr "Il voto non deve essere negativo"

#: api.py:666
msgid "score must be positive"
msgstr "il punteggio deve essere positivo"
