#: api.py:125
msgid ""
"The CSV does not match this problem. Check that you uploaded the right CSV."
msgstr ""
"Plik CSV nie odpowiada temu zadaniu. Sprawdź, czy przesłałeś właściwy plik "
"CSV."

#: api.py:130
msgid "Points must be numbers."
msgstr "Punkty muszą być liczbami."

#: api.py:132
msgid "Points must not be greater than {}."
msgstr "Punkty nie mogą być większe niż {}."

#: api.py:134
msgid "Points must be greater than 0"
msgstr "Punkty muszą być większe od 0."

#: api.py:351
msgid "Wrong course id {} != {}"
msgstr "Nieprawidłowy identyfikator kursu {} != {}"

#: api.py:367
msgid "The file has no data rows."
msgstr "Plik nie zawiera wierszy z danymi."

#: api.py:370
msgid ""
"No grades were changed. Enter grades in a \"new_override\" column and upload"
" the file again."
msgstr ""
"Nie zmieniono żadnych ocen. Wpisz oceny w kolumnie „new_override” i prześlij"
" plik ponownie."

#: api.py:383 api.py:385
msgid "Repeated user_id: "
msgstr "Powtórzony user_id: "

#: api.py:402
msgid "Grade must be a number"
msgstr "Ocena musi być liczbą"

#: api.py:405
msgid "Grade must not be negative"
msgstr "Ocena nie może być ujemna"

#: api.py:666
msgid "score must be positive"
msgstr "Wynik musi być dodatni"
