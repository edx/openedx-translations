#: api.py:125
msgid ""
"The CSV does not match this problem. Check that you uploaded the right CSV."
msgstr ""
"El CSV no coincideix amb aquest problema. Comproveu que heu penjat el CSV "
"correcte."

#: api.py:130
msgid "Points must be numbers."
msgstr "Els punts han de ser números."

#: api.py:132
msgid "Points must not be greater than {}."
msgstr "Els punts no poden ser majors que {}."

#: api.py:134
msgid "Points must be greater than 0"
msgstr "Els punts han de ser més grans que 0."

#: api.py:351
msgid "Wrong course id {} != {}"
msgstr "El codi de curs és incorrecte: {} != {}."

#: api.py:367
msgid "The file has no data rows."
msgstr "El fitxer no conté cap fila de dades."

#: api.py:370
msgid ""
"No grades were changed. Enter grades in a \"new_override\" column and upload"
" the file again."
msgstr ""
"No s'ha modificat cap qualificació. Introduïu les qualificacions en una "
"columna «new_override» i torneu a carregar el fitxer."

#: api.py:383 api.py:385
msgid "Repeated user_id: "
msgstr "user_id repetit: "

#: api.py:402
msgid "Grade must be a number"
msgstr "La qualificació ha de ser un número."

#: api.py:405
msgid "Grade must not be negative"
msgstr "La qualificació no pot ser negativa."

#: api.py:666
msgid "score must be positive"
msgstr "La puntuació ha de ser positiva."
