msgstr "Setiap contoh tanggapan untuk pelatihan peserta harus unik."

#: xblock/utils/validation.py:160
msgid "The \"required\" value must be true if staff assessment is the only step."
msgstr ""
"Nilai \"wajib\" harus benar jika penilaian staf adalah satu-satunya langkah."

#: xblock/utils/validation.py:164
