msgstr "Ο βαθμός για αυτό το πρόβλημα καθορίζεται από την αυτοαξιολόγησή σας."

#: xblock/grade_mixin.py:687
#, python-brace-format
msgid ""
"You have successfully completed this problem and received a "
"{earned_points}/{total_points}."
msgstr ""
"Έχετε ολοκληρώσει επιτυχώς αυτό το πρόβλημα και λάβατε "
"{earned_points}/{total_points}."

#: xblock/grade_mixin.py:695
