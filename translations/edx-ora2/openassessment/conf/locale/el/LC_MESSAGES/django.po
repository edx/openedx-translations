msgid ""
"No Open Response Assessment found in {course_id} with block id {block_id}"
msgstr ""
"Δεν βρέθηκε αξιολόγηση ανοιχτής απάντησης στο {course_id} με αναγνωριστικό "
"μπλοκ {block_id}"

#: xblock/staff_area_mixin.py:42
msgid "You do not have permission to schedule training"
msgstr "Δεν έχετε δικαίωμα να προγραμματίσετε εκπαίδευση"

#: xblock/staff_area_mixin.py:43
msgid "You do not have permission to reschedule tasks."
msgstr "Δεν έχετε δικαίωμα να επαναπρογραμματίσετε εργασίες."

#: xblock/staff_area_mixin.py:69
msgid "You do not have permission to access the ORA staff area"
msgstr "Δεν έχετε δικαίωμα πρόσβασης στην περιοχή προσωπικού του ORA"

#: xblock/staff_area_mixin.py:70
msgid "You do not have permission to access ORA learner information."
msgstr "Δεν έχετε δικαίωμα πρόσβασης στις πληροφορίες μαθητών του ORA."

#: xblock/staff_area_mixin.py:71
msgid "You do not have permission to access ORA staff grading."
msgstr "Δεν έχετε δικαίωμα πρόσβασης στη βαθμολόγηση προσωπικού του ORA."

#: xblock/staff_area_mixin.py:241
msgid "Pending"
msgstr "Εκκρεμεί"

#: xblock/staff_area_mixin.py:242
msgid "Complete/Overwritten"
msgstr "Ολοκληρωμένο/Αναθεωρημένο"

#: xblock/staff_area_mixin.py:245
msgid "Not applicable"
msgstr "Δεν εφαρμόζεται"

#: xblock/staff_area_mixin.py:246
msgid "Not submitted"
msgstr "Δεν υποβλήθηκε"

#: xblock/staff_area_mixin.py:247
msgid "Submitted"
msgstr "Υποβλήθηκε"

#: xblock/staff_area_mixin.py:341
msgid "Error getting learner information."
msgstr "Σφάλμα κατά την λήψη πληροφοριών μαθητή."

#: xblock/staff_area_mixin.py:384
msgid "Error loading the checked out learner response."
msgstr "Σφάλμα κατά τη φόρτωση της απάντησης του μαθητή που έχει ανατεθεί."

#: xblock/staff_area_mixin.py:385
msgid "No other learner responses are available for grading at this time."
msgstr ""
"Δεν υπάρχουν άλλες απαντήσεις μαθητών διαθέσιμες για βαθμολόγηση αυτή τη "
"στιγμή."

#: xblock/staff_area_mixin.py:387
msgid "Error getting staff grade information."
msgstr "Σφάλμα κατά την λήψη πληροφοριών βαθμολογίας από το προσωπικό."

#: xblock/staff_area_mixin.py:408
msgid "Error getting staff grade ungraded and checked out counts."
msgstr ""
"Σφάλμα κατά την λήψη των μη βαθμολογημένων και ανατεθειμένων μετρήσεων "
"βαθμών από το προσωπικό."

#: xblock/staff_area_mixin.py:703
msgid "Please enter valid reason to remove the submission."
msgstr "Παρακαλώ εισάγετε έγκυρο λόγο για την αφαίρεση της υποβολής."

#: xblock/staff_area_mixin.py:714
msgid "Submission not found"
msgstr "Η υποβολή δεν βρέθηκε"

#: xblock/staff_area_mixin.py:725
msgid "Submission for team assignment has no associated team submission"
msgstr "Η υποβολή για ομαδική εργασία δεν έχει συσχετιζόμενη ομαδική υποβολή"

#: xblock/staff_area_mixin.py:754
msgid ""
"The learner submission has been removed from peer assessment. The learner "
"receives a grade of zero unless you delete the learner's state for the "
"problem to allow them to resubmit a response."
msgstr ""
"Η υποβολή του μαθητή έχει αφαιρεθεί από την αξιολόγηση ομοτίμων. Ο μαθητής "
"λαμβάνει βαθμό μηδέν, εκτός εάν διαγράψετε την κατάσταση του μαθητή για το "
"πρόβλημα ώστε να του δοθεί η δυνατότητα επανυποβολής."

#: xblock/staff_area_mixin.py:789
msgid ""
"The team’s submission has been removed from grading. The team receives a "
"grade of zero unless you delete a team member’s state for the problem to "
"allow the team to resubmit a response."
msgstr ""
"Η υποβολή της ομάδας έχει αφαιρεθεί από τη βαθμολόγηση. Η ομάδα λαμβάνει "
"βαθμό μηδέν, εκτός αν διαγράψετε την κατάσταση ενός μέλους της ομάδας για το"
" πρόβλημα ώστε να δοθεί η δυνατότητα επανυποβολής."

#: xblock/studio_mixin.py:247 xblock/studio_mixin.py:259
msgid "Error updating XBlock configuration"
msgstr "Σφάλμα ενημέρωσης της ρύθμισης XBlock"

#: xblock/studio_mixin.py:264
msgid "Error: Text Response and File Upload Response cannot both be disabled"
msgstr ""
"Σφάλμα: Η απάντηση σε κείμενο και η απάντηση με μεταφόρτωση αρχείου δεν "
"μπορούν να απενεργοποιηθούν ταυτόχρονα"

#: xblock/studio_mixin.py:268
msgid ""
"Error: When Text Response is disabled, File Upload Response must be Required"
msgstr ""
"Σφάλμα: Όταν η απάντηση σε κείμενο είναι απενεργοποιημένη, η απάντηση με "
"μεταφόρτωση αρχείου πρέπει να είναι υποχρεωτική"

#: xblock/studio_mixin.py:271
msgid ""
"Error: When File Upload Response is disabled, Text Response must be Required"
msgstr ""
"Σφάλμα: Όταν η απάντηση με μεταφόρτωση αρχείου είναι απενεργοποιημένη, η "
"απάντηση σε κείμενο πρέπει να είναι υποχρεωτική"

#: xblock/studio_mixin.py:295
#, python-brace-format
msgid "Validation error: {error}"
msgstr "Σφάλμα επικύρωσης: {error}"

#: xblock/studio_mixin.py:329
msgid "Successfully updated OpenAssessment XBlock"
msgstr "Επιτυχής ενημέρωση του OpenAssessment XBlock"

#: xblock/utils/data_conversion.py:315
msgid "You must provide options selected in the assessment."
msgstr "Πρέπει να παρέχετε τις επιλογές που επιλέχθηκαν στην αξιολόγηση."

#: xblock/utils/data_conversion.py:318
msgid "You must provide overall feedback in the assessment."
msgstr "Πρέπει να παρέχετε συνολικά σχόλια στην αξιολόγηση."

#: xblock/utils/data_conversion.py:321
msgid "You must provide feedback for criteria in the assessment."
msgstr "Πρέπει να παρέχετε σχόλια για τα κριτήρια στην αξιολόγηση."

#: xblock/utils/resolve_dates.py:52
#, python-brace-format
msgid ""
"'{date}' is an invalid date format. Make sure the date is formatted as YYYY-"
"MM-DDTHH:MM:SS."
msgstr ""
"'{date}' δεν είναι έγκυρη μορφή ημερομηνίας. Βεβαιωθείτε ότι η ημερομηνία "
"είναι μορφοποιημένη ως YYYY-MM-DDTHH:MM:SS."

#: xblock/utils/resolve_dates.py:57
#, python-brace-format
msgid "'{date}' must be a date string or datetime"
msgstr "'{date}' πρέπει να είναι συμβολοσειρά ημερομηνίας ή datetime"

#: xblock/utils/resolve_dates.py:210
#, python-brace-format
msgid ""
"This step's start date '{start}' cannot be earlier than the previous step's "
"start date '{prev}'."
msgstr ""
"Η ημερομηνία έναρξης αυτού του βήματος '{start}' δεν μπορεί να είναι "
"νωρίτερα από την ημερομηνία έναρξης του προηγούμενου βήματος '{prev}'."

#: xblock/utils/resolve_dates.py:218
#, python-brace-format
msgid ""
"This step's due date '{due}' cannot be later than the next step's due date "
"'{prev}'."
msgstr ""
"Η προθεσμία αυτού του βήματος '{due}' δεν μπορεί να είναι μεταγενέστερη από "
"την προθεσμία του επόμενου βήματος '{prev}'."

#: xblock/utils/resolve_dates.py:234
#, python-brace-format
msgid "The start date '{start}' cannot be later than the due date '{due}'"
msgstr ""
"Η ημερομηνία έναρξης '{start}' δεν μπορεί να είναι μεταγενέστερη από την "
"προθεσμία '{due}'"

#: xblock/utils/validation.py:120
msgid "This problem must include at least one assessment."
msgstr "Το πρόβλημα πρέπει να περιλαμβάνει τουλάχιστον μία αξιολόγηση."

#: xblock/utils/validation.py:124
msgid "The assessment order you selected is invalid."
msgstr "Η σειρά αξιολόγησης που επιλέξατε δεν είναι έγκυρη."

#: xblock/utils/validation.py:134
msgid "In peer assessment, the \"Must Grade\" value must be a positive integer."
msgstr ""
"Στην αξιολόγηση ομοτίμων, η τιμή \"Πρέπει να βαθμολογηθεί\" πρέπει να είναι "
"θετικός ακέραιος."

#: xblock/utils/validation.py:137
msgid "In peer assessment, the \"Graded By\" value must be a positive integer."
msgstr ""
"Στην αξιολόγηση ομοτίμων, η τιμή \"Βαθμολογήθηκε από\" πρέπει να είναι "
"θετικός ακέραιος."

#: xblock/utils/validation.py:141
msgid ""
"In peer assessment, the \"Must Grade\" value must be greater than or equal "
"to the \"Graded By\" value."
msgstr ""
"Στην αξιολόγηση ομοτίμων, η τιμή \"Πρέπει να βαθμολογηθεί\" πρέπει να είναι "
"μεγαλύτερη ή ίση με την τιμή \"Βαθμολογήθηκε από\"."

#: xblock/utils/validation.py:150
msgid "You must provide at least one example response for learner training."
msgstr ""
"Πρέπει να παρέχετε τουλάχιστον μία παράδειγμα απάντησης για την εκπαίδευση "
"μαθητών."

#: xblock/utils/validation.py:153
msgid "Each example response for learner training must be unique."
msgstr ""
"Κάθε παράδειγμα απάντησης για την εκπαίδευση μαθητών πρέπει να είναι "
"μοναδικό."

#: xblock/utils/validation.py:160
msgid "The \"required\" value must be true if staff assessment is the only step."
msgstr ""
"Η τιμή \"υποχρεωτικό\" πρέπει να είναι αληθής αν η αξιολόγηση προσωπικού "
"είναι το μόνο βήμα."

#: xblock/utils/validation.py:164
msgid ""
"The number of assessments cannot be changed after the problem has been "
"released."
msgstr ""
"Ο αριθμός των αξιολογήσεων δεν μπορεί να αλλάξει αφού το πρόβλημα "
"δημοσιευθεί."

#: xblock/utils/validation.py:169
msgid ""
"The assessment type cannot be changed after the problem has been released."
msgstr ""
"Ο τύπος αξιολόγησης δεν μπορεί να αλλάξει αφού το πρόβλημα δημοσιευθεί."

#: xblock/utils/validation.py:176
msgid ""
"The grading strategy for peer assessments cannot be changed after the "
"problem has been released."
msgstr ""
"Η στρατηγική βαθμολόγησης για τις αξιολογήσεις ομοτίμων δεν μπορεί να "
"αλλάξει αφού το πρόβλημα δημοσιευθεί."

#: xblock/utils/validation.py:200
msgid "This rubric definition is not valid."
msgstr "Ο ορισμός αυτού του κριτηρίου δεν είναι έγκυρος."

#: xblock/utils/validation.py:203
msgid "You must provide at least one prompt."
msgstr "Πρέπει να παρέχετε τουλάχιστον μία προτροπή."

#: xblock/utils/validation.py:209
#, python-brace-format
msgid "Options in '{criterion}' have duplicate name(s): {duplicates}"
msgstr "Οι επιλογές στο '{criterion}' έχουν διπλές ονομασίες: {duplicates}"

#: xblock/utils/validation.py:217
msgid "Criteria with no options must require written feedback."
msgstr "Τα κριτήρια χωρίς επιλογές πρέπει να απαιτούν γραπτά σχόλια."

#: xblock/utils/validation.py:226
msgid "Prompts cannot be created or deleted after a problem is released."
msgstr ""
"Οι προτροπές δεν μπορούν να δημιουργηθούν ή να διαγραφούν αφού το πρόβλημα "
"δημοσιευθεί."

#: xblock/utils/validation.py:230
msgid "The number of criteria cannot be changed after a problem is released."
msgstr ""
"Ο αριθμός των κριτηρίων δεν μπορεί να αλλάξει αφού το πρόβλημα δημοσιευθεί."

#: xblock/utils/validation.py:243
msgid "Criteria names cannot be changed after a problem is released"
msgstr ""
"Τα ονόματα των κριτηρίων δεν μπορούν να αλλάξουν αφού το πρόβλημα "
"δημοσιευθεί"

#: xblock/utils/validation.py:248
msgid "The number of options cannot be changed after a problem is released."
msgstr ""
"Ο αριθμός των επιλογών δεν μπορεί να αλλάξει αφού το πρόβλημα δημοσιευθεί."

#: xblock/utils/validation.py:253
msgid "Point values cannot be changed after a problem is released."
msgstr ""
"Οι τιμές βαθμισμού δεν μπορούν να αλλάξουν αφού το πρόβλημα δημοσιευθεί."

#: xblock/utils/validation.py:304
msgid "Learner training must have at least one training example."
msgstr ""
"Η εκπαίδευση μαθητών πρέπει να έχει τουλάχιστον ένα παράδειγμα εκπαίδευσης."

#: xblock/utils/validation.py:369
msgid "Leaderboard number is invalid."
msgstr "Ο αριθμός του βαθμολογικού πίνακα δεν είναι έγκυρος."

#: xblock/utils/validation.py:392
msgid "The submission format is invalid."
msgstr "Η μορφή της υποβολής δεν είναι έγκυρη."
