msgstr "Όνομα επιλογής"

#: templates/legacy/edit/oa_edit_option.html:29
msgid "Option Points"
msgstr "Πόντοι επιλογής"

#: templates/legacy/edit/oa_edit_option.html:42
msgid "Option Explanation"
