#: models.py:39
msgid "Display Correctness?"
msgstr "Отображать правильность?"

#: models.py:41
msgid ""
"This is a flag that indicates if the indicator icon should be displayed "
"after a student enters their response"
msgstr ""
"Это флаг, указывающий, следует ли отображать значок индикатора после того, "
"как студент введет свой ответ"

#: models.py:49
msgid "Display Other Student Responses"
msgstr "Отображать ответы других студентов"

#: models.py:51
msgid ""
"This will display other student responses to the student after they submit "
"their response."
msgstr "После отправки ответа студенту будут показаны ответы других студентов"

#: models.py:60
msgid "System selected answers to give to students"
msgstr "Ответы, выбранные системой для студентов"

#: models.py:63
msgid "Display Name"
msgstr "Отображаемое имя"

#: models.py:65
msgid "This is the title for this question type"
msgstr "Это заголовок для данного типа вопроса"

#: models.py:71
msgid "Full-Credit Key Phrases"
msgstr "Ключевые фразы для полного балла"

#: models.py:73
msgid ""
"This is a list of words or phrases, one of which must be present in order "
"for the student's answer to receive full credit"
msgstr ""
"Это список слов или фраз, одно из которых должно присутствовать, чтобы ответ"
" студента получил полный балл"

#: models.py:81
msgid "Half-Credit Key Phrases"
msgstr "Ключевые фразы для получения половины балла"

#: models.py:83
msgid ""
"This is a list of words or phrases, one of which must be present in order "
"for the student's answer to receive half credit"
msgstr ""
"Это список слов или фраз, одно из которых должно присутствовать, чтобы ответ"
" студента получил половинный балл"

#: models.py:91
msgid "Maximum Number of Attempts"
msgstr "Максимальное количество попыток"

#: models.py:93
msgid ""
"This is the maximum number of times a student is allowed to attempt the "
"problem"
msgstr ""
"Это максимальное количество попыток, разрешенных студенту для решения задачи"

#: models.py:101
msgid "Maximum Word Count"
msgstr "Максимальное количество слов"

#: models.py:103
msgid "This is the maximum number of words allowed for this question"
msgstr "Это максимально допустимое количество слов для данного вопроса"

#: models.py:111
msgid "Minimum Word Count"
msgstr "Минимальное количество слов"

#: models.py:113
msgid "This is the minimum number of words required for this question"
msgstr "Это минимальное количество слов, необходимое для данного вопроса"

#: models.py:121
msgid "Prompt"
msgstr "Подсказка"

#: models.py:123
msgid ""
"This is the prompt students will see when asked to enter their response"
msgstr "Это подсказка, которую увидят студенты при вводе ответа"

#: models.py:131
msgid "Submission Received Message"
msgstr "Сообщение о получении отправленного ответа"

#: models.py:133
msgid "This is the message students will see upon submitting their response"
msgstr "Это сообщение, которое увидят студенты после отправки своего ответа"

#: models.py:140
msgid "Weight"
msgstr "Вес"

#: models.py:142
msgid "This assigns an integer value representing the weight of this problem"
msgstr "Это устанавливает целочисленное значение, представляющее вес задачи"

#: models.py:150
msgid "Draft Received Message"
msgstr "Сообщение о получении черновика"

#: models.py:152
msgid "This is the message students will see upon submitting a draft response"
msgstr "Это сообщение, которое увидят студенты при отправке черновика ответа"

#: templates/view.html:15
msgid ""
"Allow my response to possibly be visible by other learners after submitting "
"their response"
msgstr ""
"Разрешить, чтобы мой ответ мог быть виден другим учащимся после его отправки"

#: templates/view.html:21 templates/view.html:24
msgid "Checking..."
msgstr "Проверка..."

#: templates/view.html:21 templates/view.html:22
msgid "Submit"
msgstr "Отправить"

#: templates/view.html:24 templates/view.html:25
msgid "Save"
msgstr "Сохранить"

#: templates/view.html:34
msgid "Hide"
msgstr "Скрыть"

#: templates/view.html:35
msgid "Show"
msgstr "Показать"

#: templates/view.html:36
msgid "peer responses"
msgstr "Ответы сверстников"

#: templates/view.html:38
msgid "Submissions by others"
msgstr "Работы, отправленные другими"

#: templates/view.html:39 templates/view.html:43
msgid "No responses to show at this time"
msgstr "Сейчас нет ответов для отображения"

#: views.py:126
#, python-brace-format
msgid "{weight} point possible"
msgid_plural "{weight} points possible"
msgstr[0] "Можно набрать {weight} балл"
msgstr[1] "Можно набрать {weight} балла"
msgstr[2] "Можно набрать {weight} баллов"
msgstr[3] "Можно набрать {weight} баллов"

#: views.py:134
#, python-brace-format
msgid "{score_string}/{weight} point"
msgid_plural "{score_string}/{weight} points"
msgstr[0] "{score_string}/{weight} балл"
msgstr[1] "{score_string}/{weight} балла"
msgstr[2] "{score_string}/{weight} баллов"
msgstr[3] "{score_string}/{weight} баллов"

#: views.py:147
#, python-brace-format
msgid "You have used {count_attempts} of {max_attempts} submission"
msgid_plural "You have used {count_attempts} of {max_attempts} submissions"
msgstr[0] "Вы использовали {count_attempts} из {max_attempts} попытку"
msgstr[1] "Вы использовали {count_attempts} из {max_attempts} попытки"
msgstr[2] "Вы использовали {count_attempts} из {max_attempts} попыток"
msgstr[3] "Вы использовали {count_attempts} из {max_attempts} попыток"

#: views.py:171
#, python-brace-format
msgid "Your response must be between {min} and {max} word."
msgid_plural "Your response must be between {min} and {max} words."
msgstr[0] "Ваш ответ должен содержать от {min} до {max} слово"
msgstr[1] "Ваш ответ должен содержать от {min} до {max} слова"
msgstr[2] "Ваш ответ должен содержать от {min} до {max} слов"
msgstr[3] "Ваш ответ должен содержать от {min} до {max} слов"

#: views.py:267
#, python-brace-format
msgid "Invalid Word Count. {word_count_message}"
msgstr "Неверное количество слов. {word_count_message}"
