#: models.py:39
msgid "Display Correctness?"
msgstr "Exibir Correção?"

#: models.py:41
msgid ""
"This is a flag that indicates if the indicator icon should be displayed "
"after a student enters their response"
msgstr ""
"Esta é uma flag que indica se o ícone de indicador deve ser exibido depois "
"que o aluno inserir a sua resposta"

#: models.py:49
msgid "Display Other Student Responses"
msgstr "Exibir Respostas de Outros Alunos"

#: models.py:51
msgid ""
"This will display other student responses to the student after they submit "
"their response."
msgstr ""
"Isto exibirá as respostas de outros alunos para o estudante depois de "
"submeter a sua resposta."

#: models.py:60
msgid "System selected answers to give to students"
msgstr "Respostas selecionadas pelo sistema para fornecer aos alunos"

#: models.py:63
msgid "Display Name"
msgstr "Nome de Exibição"

#: models.py:65
msgid "This is the title for this question type"
msgstr "Este é o título para este tipo de questão"

#: models.py:71
msgid "Full-Credit Key Phrases"
msgstr "Frases-chave para Crédito Total"

#: models.py:73
msgid ""
"This is a list of words or phrases, one of which must be present in order "
"for the student's answer to receive full credit"
msgstr ""
"Esta é uma lista de palavras ou frases, uma das quais deve estar presente "
"para que a resposta do aluno receba crédito total"

#: models.py:81
msgid "Half-Credit Key Phrases"
msgstr "Frases-chave para Crédito Parcial"

#: models.py:83
msgid ""
"This is a list of words or phrases, one of which must be present in order "
"for the student's answer to receive half credit"
msgstr ""
"Esta é uma lista de palavras ou frases, uma das quais deve estar presente "
"para que a resposta do aluno receba crédito parcial"

#: models.py:91
msgid "Maximum Number of Attempts"
msgstr "Número Máximo de Tentativas"

#: models.py:93
msgid ""
"This is the maximum number of times a student is allowed to attempt the "
"problem"
msgstr ""
"Este é o número máximo de vezes que um aluno pode tentar resolver o problema"

#: models.py:101
msgid "Maximum Word Count"
msgstr "Número Máximo de Palavras"

#: models.py:103
msgid "This is the maximum number of words allowed for this question"
msgstr "Este é o número máximo de palavras permitidas para esta questão"

#: models.py:111
msgid "Minimum Word Count"
msgstr "Número Mínimo de Palavras"

#: models.py:113
msgid "This is the minimum number of words required for this question"
msgstr "Este é o número mínimo de palavras exigido para esta questão"

#: models.py:121
msgid "Prompt"
msgstr "Enunciado"

#: models.py:123
msgid ""
"This is the prompt students will see when asked to enter their response"
msgstr ""
"Esta é a indicação que os alunos verão quando forem solicitados a inserir a "
"sua resposta"

#: models.py:131
msgid "Submission Received Message"
msgstr "Mensagem de Receção da Submissão"

#: models.py:133
msgid "This is the message students will see upon submitting their response"
msgstr "Esta é a mensagem que os alunos verão ao submeter a sua resposta"

#: models.py:140
msgid "Weight"
msgstr "Peso"

#: models.py:142
msgid "This assigns an integer value representing the weight of this problem"
msgstr "Isto atribui um valor inteiro que representa o peso deste problema"

#: models.py:150
msgid "Draft Received Message"
msgstr "Mensagem de Receção do Rascunho"

#: models.py:152
msgid "This is the message students will see upon submitting a draft response"
msgstr ""
"Esta é a mensagem que os alunos verão ao submeter um rascunho de resposta"

#: templates/view.html:15
msgid ""
"Allow my response to possibly be visible by other learners after submitting "
"their response"
msgstr ""
"Permitir que a minha resposta possa possivelmente ser vista por outros "
"alunos após submeterem a sua resposta"

#: templates/view.html:21 templates/view.html:24
msgid "Checking..."
msgstr "A verificar..."

#: templates/view.html:21 templates/view.html:22
msgid "Submit"
msgstr "Submeter"

#: templates/view.html:24 templates/view.html:25
msgid "Save"
msgstr "Guardar"

#: templates/view.html:34
msgid "Hide"
msgstr "Ocultar"

#: templates/view.html:35
msgid "Show"
msgstr "Mostrar"

#: templates/view.html:36
msgid "peer responses"
msgstr "respostas de pares"

#: templates/view.html:38
msgid "Submissions by others"
msgstr "Submissões de outros"

#: templates/view.html:39 templates/view.html:43
msgid "No responses to show at this time"
msgstr "Sem respostas para exibir neste momento"

#: views.py:126
#, python-brace-format
msgid "{weight} point possible"
msgid_plural "{weight} points possible"
msgstr[0] "{weight} ponto possível"
msgstr[1] "{weight} pontos possíveis"
msgstr[2] "{weight} pontos possíveis"

#: views.py:134
#, python-brace-format
msgid "{score_string}/{weight} point"
msgid_plural "{score_string}/{weight} points"
msgstr[0] "{score_string}/{weight} ponto"
msgstr[1] "{score_string}/{weight} pontos"
msgstr[2] "{score_string}/{weight} pontos"

#: views.py:147
#, python-brace-format
msgid "You have used {count_attempts} of {max_attempts} submission"
msgid_plural "You have used {count_attempts} of {max_attempts} submissions"
msgstr[0] "Utilizaste {count_attempts} de {max_attempts} submissão"
msgstr[1] "Utilizaste {count_attempts} de {max_attempts} submissões"
msgstr[2] "Utilizaste {count_attempts} de {max_attempts} submissões"

#: views.py:171
#, python-brace-format
msgid "Your response must be between {min} and {max} word."
msgid_plural "Your response must be between {min} and {max} words."
msgstr[0] "A tua resposta deve ter entre {min} e {max} palavra."
msgstr[1] "A tua resposta deve ter entre {min} e {max} palavras."
msgstr[2] "A tua resposta deve ter entre {min} e {max} palavras."

#: views.py:267
#, python-brace-format
msgid "Invalid Word Count. {word_count_message}"
msgstr "Contagem de Palavras Inválida. {word_count_message}"
